(ns erasure-core
  (:export [gf-add gf-mul gf-pow gf-inv gf-div
            layout-admissible?
            group-count shard-count group-of local-parity-of
            group-start group-end group-size role-of role-index-of
            global-parity-index
            cauchy-entry generator-entry
            data-missing-from cover-missing locally-repairable?
            erased-in-data-from local-repair-target
            local-repair-reads repairable-group-from first-repairable-group
            drain-steps-from local-drain-steps drain-residual
            fully-local-repairable?
            gopalan-distance-bound max-tolerated-erasures]))

;; A `.kotoba` port of the DECISION layer of this library, per ADR-2607299200
;; section 5: the generator matrix and the repair plan are decisions and belong
;; in the verified language; the multiply-accumulate over megabytes is
;; mechanism and stays in a host provider.
;;
;; Everything here maps small values to small values, so the whole module sits
;; in the kotoba/pure profile — no capabilities, no shard bytes. A shard is
;; never a Kotoba value: today's compile path caps a string leaf at 64 KiB and
;; an EDN value at 1 MiB, and even when that lifts (migration plan W4) feeding
;; a 4 MiB shard through here would be putting mechanism in the wrong place.
;;
;; `erasure.gf`, `erasure.matrix` and `erasure.lrc` on the .cljc side mirror
;; these functions one for one, and `erasure.kotoba-parity-test` compiles this
;; file and asserts equality on every case rather than on a sample.

;; --- GF(2^8) --------------------------------------------------------------
;; Reduction polynomial 285 = 0x11D (x^8 + x^4 + x^3 + x^2 + 1), alpha = 2.
;; No tables: 285 as a literal plus shift-and-add is smaller than a 256-entry
;; vector would be, and it is the same algorithm `erasure.gf/mul-def` states.

(defn gf-add [a :i64 b :i64] :i64
  (bit-xor a b))

(defn gf-mul [a :i64 b :i64] :i64
  ;; Each round folds bit 0 of y with the current x, then doubles x and
  ;; reduces when it overflows 8 bits. `quot y 2` rather than a shift keeps
  ;; the loop readable; both are one instruction.
  (loop [x (bit-and a 255)
         y (bit-and b 255)
         acc 0]
    (if (zero? y)
      acc
      (recur (let [doubled (i64-shift-left x 1)]
               (if (< doubled 256)
                 doubled
                 (bit-xor doubled 285)))
             (quot y 2)
             (if (= 1 (bit-and y 1))
               (bit-xor acc x)
               acc)))))

(defn gf-pow [a :i64 e :i64] :i64
  (loop [base (bit-and a 255)
         exp e
         acc 1]
    (if (zero? exp)
      acc
      (recur (gf-mul base base)
             (quot exp 2)
             (if (= 1 (bit-and exp 1))
               (gf-mul acc base)
               acc)))))

(defn gf-inv [a :i64] :i64
  ;; a^255 = 1 for every non-zero a, so a^254 is the inverse. Zero has none
  ;; and yields zero, matching `erasure.gf/inv` — callers guard first.
  (if (zero? a)
    0
    (gf-pow a 254)))

(defn gf-div [a :i64 b :i64] :i64
  ;; `erasure.gf/div`, exactly: multiply by the inverse.
  ;;
  ;; NOTE ON THE .cljc's PRECONDITION. `erasure.gf/div` documents "`b` must be
  ;; non-zero" but does not enforce it: `inv` returns 0 for 0 rather than
  ;; throwing, so `(div a 0)` is silently 0 — a wrong answer wearing the shape
  ;; of a right one. This port mirrors that, because a parity gate compares
  ;; behaviour and cannot both mirror and correct. Recorded, not fixed: the
  ;; fix is a signature change on the .cljc side and belongs to whoever owns
  ;; its callers, not to this slice.
  ;;
  ;; A `[:result :i64 :string]` refusal was measured to compile and run here,
  ;; but it costs this layer something specific: `result-ok-of` /
  ;; `result-err-of` are not admitted by `kotoba.kir`'s
  ;; `only-native-word-typed-features?` (measured 2026-08-12, with an :i64
  ;; error payload as well as a :string one), so a Result-returning `gf-div`
  ;; would take the whole GF layer out of native-AOT admission. That is a
  ;; trade to make deliberately, not a detail to slip into a port.
  (gf-mul a (gf-inv b)))

;; --- layout ---------------------------------------------------------------

(defn layout-admissible? [k :i64 r :i64 g :i64] :bool
  ;; The three preconditions `erasure.lrc/layout` states as `assert`, as a
  ;; decision instead of a host exception: k and g positive, locality at least
  ;; 2 (below that a "local parity" is a duplicate, not a code), and k + g
  ;; within 256 so the Cauchy construction has distinct GF(2^8) elements to
  ;; draw x_i and y_j from.
  ;;
  ;; The .cljc throws an AssertionError, which is exactly the host-specific
  ;; signalling this language has no `throw` for. The predicate crosses; the
  ;; signalling stays where it can name a host exception type.
  (if (< k 1)
    false
    (if (< g 1)
      false
      (if (< r 2)
        false
        (if (< 256 (+ k g))
          false
          true)))))

(defn group-count [k :i64 r :i64] :i64
  (quot (+ k (- r 1)) r))

(defn shard-count [k :i64 r :i64 g :i64] :i64
  (+ k (+ (group-count k r) g)))

(defn group-of [i :i64 r :i64] :i64
  (quot i r))

(defn local-parity-of [k :i64 q :i64] :i64
  (+ k q))

(defn group-start [q :i64 r :i64] :i64
  (* q r))

(defn group-end [k :i64 r :i64 q :i64] :i64
  ;; The last group is short when r does not divide k.
  (let [e (* (+ q 1) r)]
    (if (< k e) k e)))

(defn group-size [k :i64 r :i64 q :i64] :i64
  (- (group-end k r q) (group-start q r)))

(defn role-of [k :i64 r :i64 g :i64 i :i64] :i64
  ;; 0 data, 1 local parity, 2 global parity, 3 out of range. An i64 tag
  ;; rather than a variant: the .cljc side returns a keyword, and comparing
  ;; small integers across the two runtimes needs no marshalling.
  (if (< i 0)
    3
    (if (< i k)
      0
      (if (< i (+ k (group-count k r)))
        1
        (if (< i (shard-count k r g))
          2
          3)))))

(defn role-index-of [k :i64 r :i64 g :i64 i :i64] :i64
  ;; The OTHER half of `erasure.lrc/role`. That function returns a map with
  ;; two things in it — a `:kind` and a `:group`/`:index` — and only the kind
  ;; had crossed. This is the number: the local group for a data shard, the
  ;; group it covers for a local parity, the Cauchy row for a global parity,
  ;; and -1 out of range.
  ;;
  ;; -1 rather than an option for the same reason `role-of` is an i64 tag:
  ;; the shard indices being classified are all non-negative, so -1 is a value
  ;; the codomain cannot otherwise produce, and it compares across the two
  ;; runtimes without marshalling.
  (let [role (role-of k r g i)]
    (if (= role 0)
      (group-of i r)
      (if (= role 1)
        (- i k)
        (if (= role 2)
          (- i (+ k (group-count k r)))
          -1)))))

(defn global-parity-index [k :i64 r :i64 i :i64] :i64
  ;; `erasure.lrc/global-parity-index`, with its nil as -1.
  ;;
  ;; NOTE: this is deliberately NOT `role-index-of` restricted to globals. The
  ;; .cljc checks only the lower edge — `(when (>= i (+ k l)) (- i k l))` — so
  ;; for an index past the last shard it answers with a positive row number
  ;; for a Cauchy row that does not exist, rather than nil. Mirrored as-is so
  ;; the gate compares behaviour; `role-index-of` is the bounded one, and it
  ;; needs `g` to be bounded, which is precisely what the .cljc's signature
  ;; does not take. Recorded, not fixed.
  (let [base (+ k (group-count k r))]
    (if (< i base)
      -1
      (- i base))))

;; --- generator matrix -----------------------------------------------------

(defn cauchy-entry [k :i64 i :i64 j :i64] :i64
  ;; C[i][j] = 1/(x_i + y_j) with x_i = k+i and y_j = j. The sets are
  ;; disjoint because k+i >= k > j, so the xor is never zero and every square
  ;; submatrix is nonsingular.
  (gf-inv (bit-xor (+ k i) j)))

(defn generator-entry [k :i64 r :i64 g :i64 i :i64 j :i64] :i64
  ;; Coefficient of data shard j in shard i — the whole generator matrix as
  ;; one function. A local parity is the sum of its group's identity rows,
  ;; which is why it carries a real equation and belongs in a global solve.
  (let [role (role-of k r g i)]
    (if (= role 0)
      (if (= i j) 1 0)
      (if (= role 1)
        (if (= (group-of j r) (- i k)) 1 0)
        (if (= role 2)
          (cauchy-entry k (- i (+ k (group-count k r))) j)
          0)))))

;; --- local repair decision ------------------------------------------------
;; The 99% path. A single lost shard inside a group is rebuilt by xoring the
;; rest of that group's cover, costing `group-size` reads and zero multiplies.

;; NOTE ON SHAPE. `max-parameters` in this compiler is 5, and a `loop` counts
;; its bindings PLUS every outer variable its body captures against that
;; budget. Walking a group while holding k/r/q/erased/end blows it. So the
;; scans below are written as explicit tail-recursive functions whose state is
;; all in the parameter list — no captures, nothing to overflow. This is a
;; real constraint of the current compile path, not a style choice.

(defn data-missing-from [end :i64 j :i64 erased [:set :i64] acc :i64] :i64
  ;; How many data shards in [j, end) are erased.
  (if (< j end)
    (data-missing-from end (+ j 1) erased
                       (if (typed-set-contains [:set :i64] erased j)
                         (+ acc 1)
                         acc))
    acc))

(defn cover-missing [k :i64 r :i64 q :i64 erased [:set :i64]] :i64
  ;; How many of group q's cover — its data shards plus its local parity —
  ;; are erased.
  (+ (data-missing-from (group-end k r q) (group-start q r) erased 0)
     (if (typed-set-contains [:set :i64] erased (local-parity-of k q))
       1
       0)))

(defn locally-repairable? [k :i64 r :i64 q :i64 erased [:set :i64]] :bool
  ;; Folded through `if` with literal true/false rather than returned
  ;; directly: a comparison is usable as an `if` condition in this profile
  ;; but does not carry type :bool in a value position, the same wrinkle
  ;; `or` has. Returning `(= 1 ...)` is an expression type mismatch.
  (if (= 1 (cover-missing k r q erased))
    true
    false))

(defn local-repair-reads [k :i64 r :i64 q :i64] :i64
  ;; Cover size is group-size + 1; rebuilding one member reads the others.
  (group-size k r q))

(defn repairable-group-from [k :i64 r :i64 q :i64 erased [:set :i64]] :i64
  (if (< q (group-count k r))
    (if (locally-repairable? k r q erased)
      q
      (repairable-group-from k r (+ q 1) erased))
    -1))

(defn first-repairable-group [k :i64 r :i64 erased [:set :i64]] :i64
  ;; Lowest-numbered group that can finish on its own, or -1. Lowest-first is
  ;; not cosmetic: it is what makes the plan comparable to the .cljc side for
  ;; equality instead of for plausibility.
  (repairable-group-from k r 0 erased))

(defn erased-in-data-from [end :i64 j :i64 erased [:set :i64]] :i64
  ;; Lowest erased data index in [j, end), or -1. The counting twin of this
  ;; scan is `data-missing-from`; this one reports WHICH.
  (if (< j end)
    (if (typed-set-contains [:set :i64] erased j)
      j
      (erased-in-data-from end (+ j 1) erased))
    -1))

(defn local-repair-target [k :i64 r :i64 q :i64 erased [:set :i64]] :i64
  ;; Which shard a local repair of group q rebuilds, or -1 when the group
  ;; cannot finish on its own.
  ;;
  ;; The port could already decide THAT a group is locally repairable and
  ;; WHICH group goes first; it could not say what comes out. That is the
  ;; output of step 1 of `erasure.lrc/recovery-plan` — `[target reads]` — and
  ;; without it the drain below cannot be expressed at all.
  ;;
  ;; The cover is the group's data shards plus its local parity, and exactly
  ;; one of them is erased when `locally-repairable?` holds, so if no data
  ;; member is erased the local parity is the one.
  (if (locally-repairable? k r q erased)
    (let [d (erased-in-data-from (group-end k r q) (group-start q r) erased)]
      (if (< d 0)
        (local-parity-of k q)
        d))
    -1))

;; --- the local drain ------------------------------------------------------
;; Step 1 of `erasure.lrc/recovery-plan`: drain every group that is missing
;; exactly one of its cover, to a fixpoint. This is the whole 99% path — the
;; single-node loss that costs r reads and no multiplies — so it is a
;; decision, not mechanism.
;;
;; What stays host-side is the STEP LIST. A step carries a variable-length
;; `:reads` vector, and a vector of vectors is not a value this compile path
;; has. The counts below are what the plan's shape reduces to once the read
;; lists are dropped, and they pin the same control flow: how many local
;; repairs happen, what is left when they stop, and whether that is nothing.
;;
;; NOTE ON THE FIXPOINT, recorded not fixed. `recovery-plan` says it repeats
;; "because rebuilding a group's data shard can make that group's local parity
;; rebuildable in the next round". For this layout that cannot happen: group
;; q's cover is its data shards plus shard k+q, and those covers are pairwise
;; disjoint, so no repair ever changes another group's missing count and a
;; group missing two of its own cover is never rescued by a further round. The
;; loop is correct, just never iterates more than once per group.
;; `erasure.kotoba-parity-test/drain-covers-disjoint-groups-in-one-pass`
;; asserts both halves of that. The port mirrors the loop rather than the
;; shortcut it collapses to, so that if the covers ever overlap — a second
;; parity per group, say — this side is already right.

(defn drain-steps-from [k :i64 r :i64 erased [:set :i64] steps :i64] :i64
  ;; TERMINATION: when `first-repairable-group` answers q >= 0,
  ;; `local-repair-target` returns a member of `erased` (the single erased
  ;; shard in q's cover), so the disj strictly shrinks the set every round.
  ;; The .cljc carries a defensive `guard > n` counter for the same property;
  ;; here the argument is structural and there is no fifth parameter to spend
  ;; on a budget anyway — `max-parameters` is 5 and this uses four.
  ;;
  ;; That argument is load-bearing and was checked, not assumed: breaking
  ;; `local-repair-target` so it names a shard NOT in `erased` makes this
  ;; diverge, and the gate observed it as a `fuel-exhausted` trap
  ;; (`ir/execute` charges a default budget of 512) rather than a wrong
  ;; answer. If the target ever stops being a member, this loop stops
  ;; terminating.
  (let [q (first-repairable-group k r erased)]
    (if (< q 0)
      steps
      (drain-steps-from k r
                        (typed-set-disj [:set :i64] erased
                                        (local-repair-target k r q erased))
                        (+ steps 1)))))

(defn local-drain-steps [k :i64 r :i64 erased [:set :i64]] :i64
  ;; How many local repairs the planner performs before it has to consider a
  ;; global solve — i.e. the number of leading `:local` steps in the .cljc
  ;; plan.
  (drain-steps-from k r erased 0))

(defn drain-residual [k :i64 r :i64 erased [:set :i64]] :i64
  ;; How many shards are still missing once the drain reaches its fixpoint.
  ;; Zero means the pattern was repaired entirely by xors, with no multiplies
  ;; and no global solve.
  (let [q (first-repairable-group k r erased)]
    (if (< q 0)
      (typed-set-count [:set :i64] erased)
      (drain-residual k r
                      (typed-set-disj [:set :i64] erased
                                      (local-repair-target k r q erased))))))

(defn fully-local-repairable? [k :i64 r :i64 erased [:set :i64]] :bool
  ;; The question the code is built to answer cheaply: can this loss be undone
  ;; without reading k shards and without a single field multiply.
  (if (zero? (drain-residual k r erased))
    true
    false))

;; --- durability bound -----------------------------------------------------

(defn gopalan-distance-bound [k :i64 r :i64 g :i64] :i64
  ;; d <= n - k - ceil(k/r) + 2 (Gopalan et al.). An UPPER bound on an
  ;; optimal LRC's minimum distance — what this construction actually
  ;; achieves is measured by `erasure.distance-test`, not assumed here.
  (+ (- (- (shard-count k r g) k) (group-count k r)) 2))

(defn max-tolerated-erasures [k :i64 r :i64 g :i64] :i64
  (- (gopalan-distance-bound k r g) 1))
