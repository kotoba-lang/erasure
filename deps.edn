{:paths ["src" "resources"]
 :version "0.1.0"
 ;; One dependency, and it is not an implementation detail: it is what makes
 ;; `kotoba/erasure_core.kotoba` the thing that RUNS.
 ;;
 ;; `erasure.kotoba-oracle` executes the shipped
 ;; `resources/erasure/oracle/erasure-core.kir.edn` through the KIR
 ;; interpreter, so the layout, the generator matrix and the local-repair
 ;; decision are what this library runs rather than what a test compares
 ;; against. The COMPILER stays test-only (see :test) — it produced the
 ;; artifact and never reaches a consumer.
 ;;
 ;; The library still has no buffer, crypto or network dependency: the one
 ;; function that touches bulk bytes (`erasure.gf/scale-add`) is the seam a
 ;; host provider replaces, and it — with the rest of the GF layer it is the
 ;; inner loop of — deliberately does NOT go through the interpreter. The
 ;; measurement that draws that line is in `erasure.kotoba-oracle`'s docstring.
 ;;
 ;; Pinned to the kir the pinned compiler emits for
 ;; (`io.github.kotoba-lang/amu` 45f0e5e3 declares kotoba-kir fa2fbb58).
 ;; They have to match: KIR is a versioned document, and an interpreter reading
 ;; a shape its emitter did not write is exactly the failure the artifact was
 ;; supposed to remove. Measured 2026-08-12 on a sibling slice: crossing that
 ;; pair (this compiler with a later interpreter) gives 1 failure and 32 errors.
 :deps {io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "fa2fbb5839c97b81fb1f6cb61787332bb55f2b9b"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for the parity gate
         ;; that compiles kotoba/erasure_core.kotoba and requires it to return
         ;; values identical to the .cljc reference (ADR-2607299200 section 5),
         ;; for the drift gate that requires the shipped artifact to BE that
         ;; compile, and for the delegation gate that substitutes a core.
         ;; The library itself has no runtime dependency on it.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "45f0e5e3d633e3fc9d8003396f64422b7566e02b"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Regenerate the shipped decision-core KIR. Combine with :test, which is
  ;; where the compiler lives:
  ;;
  ;;   clojure -M:test:gen
  ;;
  ;; The namespace lives under test/ so that the compiler cannot be reached
  ;; from anything a consumer loads.
  :gen {:main-opts ["-m" "erasure.kotoba-oracle-gen"]}
  ;; The portable suite under ClojureScript. The parity, drift and delegation
  ;; gates are JVM-only (they need the compiler), so this runs gf/codec/distance
  ;; only — which is the whole library minus the gates. The runner registers the
  ;; shipped KIR through node's `fs` first: there is no classpath on this
  ;; runtime, so `erasure.kotoba-oracle` cannot read the artifact itself.
  ;;   clojure -Sdeps '{:paths ["src" "test"]}' -M:cljs \
  ;;     -m cljs.main --target node -m erasure.cljs-runner
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      io.github.kotoba-lang/kotoba-kir
                      {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                       :git/sha "fa2fbb5839c97b81fb1f6cb61787332bb55f2b9b"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
